{
  // OpenHive — open-source newsletter platform. See README.md for deploy steps.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openhive-demo",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "public", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "openhive", "database_id": "02f96c17-7e54-4daa-9cfa-91f19716616b", "migrations_dir": "migrations" }
  ],
  "durable_objects": { "bindings": [{ "name": "COLLAB", "class_name": "CollabRoom" }, { "name": "LIVE", "class_name": "LiveRoom" }, { "name": "CHAT", "class_name": "ChatRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CollabRoom", "LiveRoom"] }, { "tag": "v2", "new_sqlite_classes": ["ChatRoom"] }],
  "send_email": [{ "name": "EMAIL" }],
  // Workers AI powers the writing assistant. Uncomment after `wrangler login` (it always runs remotely).
  // "ai": { "binding": "AI" },
  "vars": {
    "APP_NAME": "OpenHive",
    "APP_URL": "http://localhost:8787",
    "MAIL_FROM": "newsletter@trstbase.com",
    "PURCHASE_URL": "https://lnkbase.com/beehiiv",
    "PRICE_LABEL": "$30 one-time",
    "PLATFORM_FEE_PERCENT": "0",
    "CONTACT_EMAIL": "hello@trstbase.com"
  },
  "observability": { "enabled": true }
}
