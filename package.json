{
  "name": "openhive",
  "version": "1.0.0",
  "private": true,
  "description": "OpenHive \u2014 open-source newsletter platform on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply openhive --local",
    "db:migrate:remote": "wrangler d1 migrations apply openhive --remote",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/e2e.mjs",
    "deploy": "wrangler deploy",
    "build:docs": "node scripts/build-docs.mjs",
    "build:landing": "node scripts/build-landing.mjs",
    "seed": "node scripts/seed.mjs > .wrangler/seed.sql && wrangler d1 execute openhive --local --file .wrangler/seed.sql"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.152.0"
  }
}
